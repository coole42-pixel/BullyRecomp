new file mode 100644
--- /dev/null
+++ b/tests/unit/input/sdl_stick_test.cpp
@@ -0,0 +1,97 @@
+#include <catch2/catch_test_macros.hpp>
+#include <rex/input/sdl/sdl_input_driver.h>
+
+namespace rex::input::sdl {
+
+struct SDLInputDriverTestAccess {
+  static void Open(SDLInputDriver& driver, SDL_JoystickID id) {
+    driver.sdl_events_initialized_ = true;
+    driver.SDL_Gamepad_initialized_ = true;
+    // The fixture pumps SDL itself; no window or UI dispatch is needed.
+    driver.sdl_pumpevents_queued_ = true;
+    SDL_Event event{};
+    event.type = SDL_EVENT_GAMEPAD_ADDED;
+    event.gdevice.which = id;
+    driver.HandleEvent(event);
+  }
+  static void RunButton(SDLInputDriver& driver, SDL_JoystickID id) {
+    SDL_Event event{};
+    event.type = SDL_EVENT_GAMEPAD_BUTTON_DOWN;
+    event.gbutton.which = id;
+    event.gbutton.button = SDL_GAMEPAD_BUTTON_SOUTH;
+    event.gbutton.down = true;
+    driver.HandleEvent(event);
+  }
+  static void InitialForward(SDLInputDriver& driver, SDL_JoystickID id) {
+    SDL_Event event{};
+    event.type = SDL_EVENT_GAMEPAD_AXIS_MOTION;
+    event.gaxis.which = id;
+    event.gaxis.axis = SDL_GAMEPAD_AXIS_LEFTY;
+    event.gaxis.value = -32768;
+    driver.HandleEvent(event);
+  }
+  static void Close(SDLInputDriver& driver) {
+    for (auto& controller : driver.controllers_) SDL_CloseGamepad(controller.sdl);
+    driver.controllers_.clear();
+  }
+};
+
+}  // namespace rex::input::sdl
+
+TEST_CASE("SDL stick reversals recover missed axis events while run is held", "[input][sdl]") {
+  using rex::X_RESULT;
+  using namespace rex::input;
+  using namespace rex::input::sdl;
+  REQUIRE(SDL_InitSubSystem(SDL_INIT_GAMEPAD));
+  struct QuitSDL {
+    ~QuitSDL() { SDL_QuitSubSystem(SDL_INIT_GAMEPAD); }
+  } quit;
+  SDL_VirtualJoystickDesc desc{};
+  SDL_INIT_INTERFACE(&desc);
+  desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+  desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+  desc.nbuttons = 15;
+  desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1;
+  desc.button_mask = (1u << 15) - 1;
+  desc.name = "Bully turn regression pad";
+  const auto id = SDL_AttachVirtualJoystick(&desc);
+  REQUIRE(id != 0);
+  struct Detach {
+    SDL_JoystickID id;
+    ~Detach() { SDL_DetachVirtualJoystick(id); }
+  } detach{id};
+  SDLInputDriver driver(nullptr, 0);
+  SDLInputDriverTestAccess::Open(driver, id);
+  struct CloseDriver {
+    SDLInputDriver& driver;
+    ~CloseDriver() { SDLInputDriverTestAccess::Close(driver); }
+  } close{driver};
+  std::vector<DeviceInfo> devices;
+  driver.EnumerateDevices(devices);
+  REQUIRE(devices.size() == 1);
+  auto* joystick = SDL_GetJoystickFromID(id);
+  REQUIRE(joystick != nullptr);
+  REQUIRE(SDL_SetJoystickVirtualButton(joystick, SDL_GAMEPAD_BUTTON_SOUTH, true));
+  SDLInputDriverTestAccess::RunButton(driver, id);
+  SDLInputDriverTestAccess::InitialForward(driver, id);
+  X_INPUT_STATE state{};
+  uint32_t last_packet = 0;
+  // After starting forward, no axis notifications are forwarded. SDL has the
+  // authoritative positions, including a turn without releasing the stick.
+  const int16_t positions[][2] = {
+      {0, -32768}, {-32768, -24000}, {32767, -24000},
+      {-32768, 0}, {32767, 0}, {0, 0}};
+  for (const auto& position : positions) {
+    REQUIRE(SDL_SetJoystickVirtualAxis(joystick, SDL_GAMEPAD_AXIS_LEFTX, position[0]));
+    REQUIRE(SDL_SetJoystickVirtualAxis(joystick, SDL_GAMEPAD_AXIS_LEFTY, position[1]));
+    SDL_UpdateJoysticks();
+    REQUIRE(driver.GetDeviceState(devices[0].id, &state) == X_ERROR_SUCCESS);
+    REQUIRE(static_cast<int16_t>(state.gamepad.thumb_lx) == position[0]);
+    REQUIRE(static_cast<int16_t>(state.gamepad.thumb_ly) == static_cast<int16_t>(~position[1]));
+    REQUIRE((state.gamepad.buttons & X_INPUT_GAMEPAD_A) != 0);
+    REQUIRE(static_cast<uint32_t>(state.packet_number) != last_packet);
+    last_packet = state.packet_number;
+    REQUIRE(driver.GetDeviceState(devices[0].id, &state) == X_ERROR_SUCCESS);
+    REQUIRE(static_cast<uint32_t>(state.packet_number) == last_packet);
+  }
+}
