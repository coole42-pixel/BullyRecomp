+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+  REQUIRE(static_cast<int16_t>(state.gamepad.thumb_ly) == 32767);
+  REQUIRE(static_cast<uint32_t>(state.packet_number) != blocked);
+  const uint32_t resumed = state.packet_number;
+  driver->Remove(10);
+  REQUIRE(system->GetState(0, &state) == X_ERROR_DEVICE_NOT_CONNECTED);
+  REQUIRE(static_cast<int16_t>(state.gamepad.thumb_ly) == 0);
+  REQUIRE(static_cast<uint32_t>(state.packet_number) != resumed);
