+TEST_CASE("Guest packets track stick release despite a larger synthetic packet", "[input]") {
+  FakeDriver* driver;
+  auto system = SharedSystem(&driver);
+  driver->Add(10);
+  driver->Add(11, true);
+  driver->SetStick(10, 32767, 1);
+  driver->SetStick(11, 0, 10000);
+  X_INPUT_STATE state = {};
+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+  REQUIRE(static_cast<int16_t>(state.gamepad.thumb_ly) == 32767);
+  const uint32_t moving = state.packet_number;
+  driver->SetStick(10, 0, 2);
+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+  REQUIRE(static_cast<int16_t>(state.gamepad.thumb_ly) == 0);
+  REQUIRE(static_cast<uint32_t>(state.packet_number) != moving);
+  const uint32_t released = state.packet_number;
+  driver->SetStick(11, 0, 10001);
+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+  REQUIRE(static_cast<uint32_t>(state.packet_number) == released);
+}
+
+TEST_CASE("Dialog and disconnect clear movement with a new guest packet", "[input]") {
+  FakeDriver* driver;
+  auto system = SharedSystem(&driver);
+  driver->Add(10);
+  driver->SetStick(10, 32767, 1);
+  X_INPUT_STATE state = {};
+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+  const uint32_t moving = state.packet_number;
+  system->AddUIInputBlocker();
+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+  REQUIRE(static_cast<int16_t>(state.gamepad.thumb_ly) == 0);
+  REQUIRE(static_cast<uint32_t>(state.packet_number) != moving);
+  const uint32_t blocked = state.packet_number;
+  system->RemoveUIInputBlocker();
+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+  REQUIRE(static_cast<int16_t>(state.gamepad.thumb_ly) == 32767);
+  REQUIRE(static_cast<uint32_t>(state.packet_number) != blocked);
+  const uint32_t resumed = state.packet_number;
+  driver->Remove(10);
+  REQUIRE(system->GetState(0, &state) == X_ERROR_DEVICE_NOT_CONNECTED);
+  REQUIRE(static_cast<int16_t>(state.gamepad.thumb_ly) == 0);
+  REQUIRE(static_cast<uint32_t>(state.packet_number) != resumed);
+}
