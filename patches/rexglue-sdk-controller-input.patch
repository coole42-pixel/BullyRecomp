 std::unique_lock<std::mutex> SDLInputDriver::DrainAndLock() {
+  // Serialize extraction as well as application: otherwise two readers can
+  // replay an older stick event after a newer release, leaving movement stuck.
+  // The event watch takes only event_queue_mutex_, never controllers_mutex_.
+  std::unique_lock<std::mutex> guard(controllers_mutex_);
   std::vector<SDL_Event> events;
   {
     std::lock_guard<std::mutex> guard(event_queue_mutex_);
     events.swap(pending_events_);
   }
-  std::unique_lock<std::mutex> guard(controllers_mutex_);
   for (const auto& event : events) {
     ProcessEventLocked(event);
   }
+  // Axis events are notifications, not the authoritative position. Recover
+  // from missed notifications (and axes already held when a pad is opened)
+  // so a rapid direction change cannot leave the guest running on an old axis.
+  // The watch only takes event_queue_mutex_, which is no longer held here.
+  SDL_LockJoysticks();
+  for (auto& controller : controllers_) {
+    auto& pad = controller.state.gamepad;
+    const int16_t lx = SDL_GetGamepadAxis(controller.sdl, SDL_GAMEPAD_AXIS_LEFTX);
+    const int16_t ly =
+        static_cast<int16_t>(~SDL_GetGamepadAxis(controller.sdl, SDL_GAMEPAD_AXIS_LEFTY));
+    const int16_t rx = SDL_GetGamepadAxis(controller.sdl, SDL_GAMEPAD_AXIS_RIGHTX);
+    const int16_t ry =
+        static_cast<int16_t>(~SDL_GetGamepadAxis(controller.sdl, SDL_GAMEPAD_AXIS_RIGHTY));
+    const uint8_t lt = static_cast<uint8_t>(
+        SDL_GetGamepadAxis(controller.sdl, SDL_GAMEPAD_AXIS_LEFT_TRIGGER) >> 7);
+    const uint8_t rt = static_cast<uint8_t>(
+        SDL_GetGamepadAxis(controller.sdl, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) >> 7);
+    if (pad.thumb_lx != lx || pad.thumb_ly != ly || pad.thumb_rx != rx ||
+        pad.thumb_ry != ry || pad.left_trigger != lt || pad.right_trigger != rt) {
+      controller.state_changed = true;
+      pad.thumb_lx = lx;
+      pad.thumb_ly = ly;
+      pad.thumb_rx = rx;
+      pad.thumb_ry = ry;
+      pad.left_trigger = lt;
+      pad.right_trigger = rt;
+    }
+  }
+  SDL_UnlockJoysticks();
   return guard;
 }

