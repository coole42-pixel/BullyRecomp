@@ -0,0 +1,152 @@
+/**
+ * @file        tests/unit/core/timer_queue_test.cpp
+ * @brief       Unit tests for rex::thread timer queue: due-time accuracy, recurring
+ *              timers, disarm, wakeup on newly queued timers, and idle CPU use.
+ *
+ * @copyright   Copyright (c) 2026 BullyRecomp contributors
+ *              Contributed under the rexglue-sdk license.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/platform.h>
+#include <rex/thread/timer_queue.h>
+
+#if REX_PLATFORM_WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <timeapi.h>
+#pragma comment(lib, "winmm.lib")
+#endif
+
+using namespace std::chrono_literals;
+using rex::thread::QueueTimerOnce;
+using rex::thread::QueueTimerRecurring;
+using clock_type = rex::thread::TimerQueueWaitItem::clock;
+
+namespace {
+
+// Spins (with short sleeps) until `done` is set or `timeout` elapses.
+bool WaitFor(const std::atomic<bool>& done, std::chrono::milliseconds timeout) {
+  const auto deadline = clock_type::now() + timeout;
+  while (!done.load(std::memory_order_acquire)) {
+    if (clock_type::now() > deadline) {
+      return false;
+    }
+    std::this_thread::sleep_for(1ms);
+  }
+  return true;
+}
+
+}  // namespace
+
+TEST_CASE("one-shot timer fires at its due time, not before", "[timer_queue]") {
+  struct State {
+    std::atomic<bool> fired{false};
+    clock_type::time_point fired_at;
+  } state;
+  const auto due = clock_type::now() + 20ms;
+  QueueTimerOnce(
+      [](void* userdata) {
+        auto* s = static_cast<State*>(userdata);
+        s->fired_at = clock_type::now();
+        s->fired.store(true, std::memory_order_release);
+      },
+      &state, due);
+
+  REQUIRE(WaitFor(state.fired, 1000ms));
+  CHECK(state.fired_at >= due);
+  // Generous bound for loaded CI machines; locally this is well under 2 ms.
+  CHECK(state.fired_at - due < 15ms);
+}
+
+TEST_CASE("recurring 1 ms timer keeps up and stops when disarmed", "[timer_queue]") {
+  std::atomic<int> ticks{0};
+  auto item = QueueTimerRecurring(
+      [](void* userdata) { static_cast<std::atomic<int>*>(userdata)->fetch_add(1); }, &ticks,
+      clock_type::now(), 1ms);
+
+  std::this_thread::sleep_for(200ms);
+  auto locked = item.lock();
+  REQUIRE(locked);
+  locked->Disarm();
+  const int at_disarm = ticks.load();
+  // Late ticks are caught up, so the count follows elapsed time.
+  CHECK(at_disarm >= 150);
+  CHECK(at_disarm <= 260);
+
+  std::this_thread::sleep_for(20ms);
+  CHECK(ticks.load() == at_disarm);
+}
+
+TEST_CASE("a timer queued while the thread waits on a later one still fires on time",
+          "[timer_queue]") {
+  std::atomic<bool> far_fired{false};
+  auto far_item =
+      QueueTimerOnce([](void* userdata) { static_cast<std::atomic<bool>*>(userdata)->store(true); },
+                     &far_fired, clock_type::now() + 10s);
+  // Let the dispatch thread go to sleep until the far deadline.
+  std::this_thread::sleep_for(20ms);
+
+  struct State {
+    std::atomic<bool> fired{false};
+    clock_type::time_point fired_at;
+  } near_state;
+  const auto near_due = clock_type::now() + 10ms;
+  QueueTimerOnce(
+      [](void* userdata) {
+        auto* s = static_cast<State*>(userdata);
+        s->fired_at = clock_type::now();
+        s->fired.store(true, std::memory_order_release);
+      },
+      &near_state, near_due);
+
+  REQUIRE(WaitFor(near_state.fired, 1000ms));
+  CHECK(near_state.fired_at - near_due < 15ms);
+  CHECK_FALSE(far_fired.load());
+  if (auto locked = far_item.lock()) {
+    locked->Disarm();
+  }
+}
+
+#if REX_PLATFORM_WIN32
+TEST_CASE("1 ms recurring timer does not keep the dispatch thread busy", "[timer_queue]") {
+  // Mirrors the runtime's KeTimeStampBundle tick. The runtime also raises the system timer
+  // resolution at startup, so do the same here.
+  timeBeginPeriod(1);
+  std::atomic<int> ticks{0};
+  auto item = QueueTimerRecurring(
+      [](void* userdata) { static_cast<std::atomic<int>*>(userdata)->fetch_add(1); }, &ticks,
+      clock_type::now(), 1ms);
+  std::this_thread::sleep_for(50ms);
+
+  auto process_cpu = [] {
+    FILETIME created, exited, kernel, user;
+    GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user);
+    ULARGE_INTEGER k{{kernel.dwLowDateTime, kernel.dwHighDateTime}};
+    ULARGE_INTEGER u{{user.dwLowDateTime, user.dwHighDateTime}};
+    return std::chrono::nanoseconds((k.QuadPart + u.QuadPart) * 100);
+  };
+  const auto cpu_before = process_cpu();
+  const int ticks_before = ticks.load();
+  std::this_thread::sleep_for(500ms);
+  const auto cpu_used = process_cpu() - cpu_before;
+  const int ticks_during = ticks.load() - ticks_before;
+  if (auto locked = item.lock()) {
+    locked->Disarm();
+  }
+  timeEndPeriod(1);
+
+  CAPTURE(std::chrono::duration_cast<std::chrono::milliseconds>(cpu_used).count(), ticks_during);
+  CHECK(ticks_during >= 400);
+  // Spinning between ticks costs a large share of a core; blocking costs a few percent.
+  CHECK(cpu_used < 50ms);
+}
+#endif
