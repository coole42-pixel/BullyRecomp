+void D3D12CommandProcessor::PrepareForWait() {
+  // A guest may stop submitting while polling the query completion sentinel.
+  // Flush unresolved query work before entering the idle or WAIT_REG_MEM loop.
+  if (submission_open_ && occlusion_queries_.HasUnsubmitted(submission_current_)) {
+    EndSubmission(false);
+  }
+  PollPendingWork();
+}
+
+bool D3D12CommandProcessor::PollPendingWork() {
+  if (!occlusion_queries_.empty() && submission_fence_) {
+    const uint64_t completed = submission_fence_->GetCompletedValue();
+    if (completed != UINT64_MAX) {
+      PublishCompletedOcclusionQueries(completed);
+      if (completed >= occlusion_wakeup_submission_) occlusion_wakeup_submission_ = 0;
+      if (!occlusion_queries_.empty() && !occlusion_wakeup_submission_ &&
+          occlusion_queries_.oldest_submission() < submission_current_ && write_ptr_index_event_) {
+        const uint64_t due = occlusion_queries_.oldest_submission();
+        if (SUCCEEDED(submission_fence_->SetEventOnCompletion(
+                due, reinterpret_cast<HANDLE>(write_ptr_index_event_->native_handle())))) {
+          occlusion_wakeup_submission_ = due;
+        }
+      }
+    }
+  }
+  return !occlusion_queries_.empty();
+}
+
+void D3D12CommandProcessor::PublishCompletedOcclusionQueries(uint64_t completed) {
+  occlusion_queries_.Retire(completed, [this](const auto& query) {
+    if (!query.guest_address || !occlusion_query_readback_mapping_) return;
+    auto* counts = memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(
+        query.guest_address);
+    // Do not overwrite an address the guest has already repurposed.
+    const uint32_t finished = rex::byte_swap(0xFFFFFEED);
+    if (counts && (counts->ZPass_A == finished || counts->ZPass_B == finished ||
+                   counts->ZFail_A == finished || counts->ZFail_B == finished)) {
+      WriteGuestOcclusionResult(counts,
+          NormalizeOcclusionSamples(occlusion_query_readback_mapping_[query.index]));
+      ++occlusion_queries_published_;
+    }
+  });
 }
 
