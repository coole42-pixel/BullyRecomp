diff --git a/tests/unit/graphics/occlusion_query_test.cpp b/tests/unit/graphics/occlusion_query_test.cpp
new file mode 100644
index 0000000..03de49c
--- /dev/null
+++ b/tests/unit/graphics/occlusion_query_test.cpp
@@ -0,0 +1,50 @@
+#include <catch2/catch_test_macros.hpp>
+#include <rex/graphics/pipeline/occlusion_query_queue.h>
+#include <vector>
+
+TEST_CASE("Occlusion slots remain reserved until their GPU fence completes", "[occlusion]") {
+  rex::graphics::OcclusionQueryQueue<2> queries;
+  uint32_t first, second, spare;
+  REQUIRE(queries.Acquire(first));
+  REQUIRE(queries.Acquire(second));
+  queries.Enqueue(first, 0x1000, 7);
+  queries.Enqueue(second, 0x2000, 8);
+  REQUIRE_FALSE(queries.Acquire(spare));
+  std::vector<uint32_t> published;
+  auto publish = [&](const auto& query) { published.push_back(query.guest_address); };
+  queries.Retire(6, publish);
+  CHECK(published.empty());
+  CHECK_FALSE(queries.Acquire(spare));
+  queries.Retire(7, publish);
+  REQUIRE(published.size() == 1);
+  CHECK(published[0] == 0x1000);
+  REQUIRE(queries.Acquire(spare));
+  CHECK(spare == first);
+  queries.Retire(8, publish);
+  CHECK(published == std::vector<uint32_t>{0x1000, 0x2000});
+  CHECK(queries.empty());
+}
+
+TEST_CASE("Occlusion batching publishes every result from a completed submission", "[occlusion]") {
+  rex::graphics::OcclusionQueryQueue<3> queries;
+  for (uint32_t address : {0u, 0x1000u, 0x2000u}) {
+    uint32_t index;
+    REQUIRE(queries.Acquire(index));
+    queries.Enqueue(index, address, 4);
+  }
+  CHECK(queries.HasUnsubmitted(4));
+  CHECK_FALSE(queries.HasUnsubmitted(5));
+  unsigned retired = 0;
+  queries.Retire(4, [&](const auto&) { ++retired; });
+  CHECK(retired == 3);
+  CHECK(queries.empty());
+  queries.Retire(5, [&](const auto&) { ++retired; });
+  CHECK(retired == 3);
+  for (unsigned i = 0; i < 3; ++i) {
+    uint32_t index;
+    REQUIRE(queries.Acquire(index));
+  }
+  queries.Reset();
+  uint32_t index;
+  CHECK(queries.Acquire(index));
+}
