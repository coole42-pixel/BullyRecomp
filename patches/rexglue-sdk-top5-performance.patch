diff --git a/include/rex/graphics/pipeline/occlusion_query_queue.h b/include/rex/graphics/pipeline/occlusion_query_queue.h
new file mode 100644
index 0000000..e5168c5
--- /dev/null
+++ b/include/rex/graphics/pipeline/occlusion_query_queue.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+
+namespace rex::graphics {
+
+// Command-processor-owned query slots. A slot remains reserved until the
+// submission that resolved it completes, even if its guest result is abandoned.
+template <size_t Capacity>
+class OcclusionQueryQueue {
+  static_assert(Capacity > 0);
+ public:
+  struct Pending {
+    uint32_t index;
+    uint32_t guest_address;
+    uint64_t submission;
+  };
+
+  bool Acquire(uint32_t& index) {
+    for (size_t i = 0; i < Capacity; ++i) {
+      const uint32_t candidate = cursor_;
+      cursor_ = (cursor_ + 1) % Capacity;
+      if (!reserved_[candidate]) {
+        reserved_[candidate] = true;
+        index = candidate;
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void Release(uint32_t index) { reserved_[index] = false; }
+  void Enqueue(uint32_t index, uint32_t address, uint64_t submission) {
+    pending_.push_back({index, address, submission});
+  }
+  bool empty() const { return pending_.empty(); }
+  uint64_t oldest_submission() const { return pending_.front().submission; }
+  bool HasUnsubmitted(uint64_t submission) const {
+    return !pending_.empty() && pending_.back().submission == submission;
+  }
+  template <typename Publish>
+  void Retire(uint64_t completed, Publish publish) {
+    while (!pending_.empty() && pending_.front().submission <= completed) {
+      const Pending query = pending_.front();
+      publish(query);
+      Release(query.index);
+      pending_.pop_front();
+    }
+  }
+  void Reset() {
+    pending_.clear();
+    reserved_.fill(false);
+    cursor_ = 0;
+  }
+
+ private:
+  std::array<bool, Capacity> reserved_{};
+  uint32_t cursor_ = 0;
+  std::deque<Pending> pending_;
+};
+
+}  // namespace rex::graphics
